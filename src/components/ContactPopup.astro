---
import { base } from '../lib/paths';
---

<div class="contact-popup" data-contact-popup hidden>
  <div class="contact-popup-bg">
    <img src={`${base}images/contact-bg.jpg`} alt="" class="contact-popup-image" />
  </div>

  <button type="button" class="contact-popup-close" data-contact-popup-close aria-label="Close">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>

  <p class="contact-popup-intro">For commissions, commercial work, or just to say hi - reach me at</p>
  <button
    type="button"
    class="contact-popup-email"
    data-contact-copy-email
    data-email="hello@madhuradharmadhikari.com"
  >hello@madhuradharmadhikari.com</button>
  <span class="contact-popup-copied" data-contact-copied hidden>Copied to clipboard</span>
</div>

<style>
  .contact-popup {
    position: fixed;
    inset: 0;
    z-index: 1000;
  }

  .contact-popup[hidden] {
    display: none;
  }

  .contact-popup-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .contact-popup-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-popup-close {
    position: absolute;
    top: 32px;
    right: 40px;
    z-index: 2;
    background: none;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    padding: 8px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .contact-popup-close:hover {
    opacity: 1;
  }

  .contact-popup-intro {
    position: absolute;
    top: 230px;
    left: var(--page-margin);
    right: var(--page-margin);
    z-index: 1;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 26px;
    font-weight: 400;
    color: var(--color-white);
  }

  .contact-popup-email {
    position: absolute;
    top: 630px;
    left: var(--page-margin);
    right: var(--page-margin);
    z-index: 1;
    display: block;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    font-family: var(--font-display);
    font-size: 58px;
    font-weight: 400;
    color: #B00000;
    cursor: pointer;
    white-space: normal;
    overflow-wrap: break-word;
    line-height: 1.2;
  }

  .contact-popup-copied {
    position: absolute;
    top: calc(630px + 90px);
    left: var(--page-margin);
    z-index: 1;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-white);
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .contact-popup-intro {
      top: 140px;
      font-size: 20px;
    }

    .contact-popup-email {
      top: 380px;
      font-size: 28px;
      line-height: 1.3;
    }

    .contact-popup-copied {
      top: calc(380px + 60px);
    }

    .contact-popup-close {
      top: 20px;
      right: 20px;
    }
  }
</style>

<script>
  function initContactPopup() {
    const root = document.querySelector<HTMLElement>('[data-contact-popup]');
    if (!root) return;

    const closeBtn = root.querySelector<HTMLButtonElement>('[data-contact-popup-close]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-contact-copy-email]');
    const copiedNote = root.querySelector<HTMLElement>('[data-contact-copied]');
    let copiedTimeout: ReturnType<typeof setTimeout> | undefined;

    function open() {
      root!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      root!.hidden = true;
      document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root!.hidden) close();
    });

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-contact-popup-trigger]');
      if (!trigger) return;
      e.preventDefault();
      open();
    });

    copyBtn?.addEventListener('click', async () => {
      const email = copyBtn.dataset.email || '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // Clipboard API unavailable; fall back silently.
      }
      if (copiedNote) {
        copiedNote.hidden = false;
        clearTimeout(copiedTimeout);
        copiedTimeout = setTimeout(() => {
          copiedNote.hidden = true;
        }, 2000);
      }
    });
  }

  initContactPopup();
</script>
