---
import { base } from '../lib/paths';
---

<div class="contact-popup" data-contact-popup hidden>
  <div class="contact-popup-card">
    <div class="contact-popup-bg">
      <img src={`${base}images/contact-bg.jpg`} alt="" class="contact-popup-image" />
    </div>

    <button type="button" class="contact-popup-close" data-contact-popup-close aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="contact-popup-text">
      <p class="contact-popup-intro">For commissions, commercial work, or just to say hi - reach me at</p>
      <button
        type="button"
        class="contact-popup-email"
        data-contact-copy-email
        data-email="hello@madhuradharmadhikari.com"
      >hello@madhuradharmadhikari.com</button>
      <span class="contact-popup-copied" data-contact-copied hidden>Copied to clipboard</span>
    </div>
  </div>
</div>

<style>
  .contact-popup {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: rgba(20, 20, 20, 0.6);
  }

  .contact-popup[hidden] {
    display: none;
  }

  .contact-popup-card {
    position: relative;
    width: 100%;
    max-width: 900px;
    aspect-ratio: 8490 / 6018;
    overflow: hidden;
  }

  .contact-popup-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .contact-popup-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-popup-close {
    position: absolute;
    top: 4%;
    right: 4%;
    z-index: 2;
    background: none;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    padding: 4px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .contact-popup-close:hover {
    opacity: 1;
  }

  .contact-popup-text {
    position: absolute;
    top: 68%;
    left: 6%;
    right: 6%;
    z-index: 1;
  }

  @media (max-width: 700px) {
    .contact-popup-text {
      top: 52%;
    }
  }

  .contact-popup-intro {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(11px, 2vw, 18px);
    font-weight: 400;
    color: var(--color-white);
  }

  .contact-popup-email {
    display: block;
    margin-top: 0.6em;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    font-family: var(--font-display);
    font-size: clamp(20px, 5.4vw, 48px);
    font-weight: 400;
    color: #B00000;
    cursor: pointer;
    white-space: normal;
    overflow-wrap: break-word;
    line-height: 1.2;
  }

  .contact-popup-copied {
    display: block;
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: clamp(11px, 1.6vw, 15px);
    color: var(--color-white);
    opacity: 0.85;
  }

  .contact-popup-copied[hidden] {
    display: none;
  }
</style>

<script>
  function initContactPopup() {
    const root = document.querySelector<HTMLElement>('[data-contact-popup]');
    if (!root) return;

    const card = root.querySelector<HTMLElement>('.contact-popup-card');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-contact-popup-close]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-contact-copy-email]');
    const copiedNote = root.querySelector<HTMLElement>('[data-contact-copied]');
    let copiedTimeout: ReturnType<typeof setTimeout> | undefined;

    function open() {
      root!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      root!.hidden = true;
      document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', close);

    root.addEventListener('click', (e) => {
      if (card && !card.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root!.hidden) close();
    });

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-contact-popup-trigger]');
      if (!trigger) return;
      e.preventDefault();
      open();
    });

    copyBtn?.addEventListener('click', async () => {
      const email = copyBtn.dataset.email || '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // Clipboard API unavailable; fall back silently.
      }
      if (copiedNote) {
        copiedNote.hidden = false;
        clearTimeout(copiedTimeout);
        copiedTimeout = setTimeout(() => {
          copiedNote.hidden = true;
        }, 2000);
      }
    });
  }

  initContactPopup();
</script>
