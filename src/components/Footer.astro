---
import ContactPopup from './ContactPopup.astro';
---

<footer class="site-footer">
  <span class="copyright">&copy; 2026 Madhura Dharmadhikari</span>
  <div class="footer-links">
    <button type="button" data-contact-popup-trigger aria-label="Email" class="footer-icon footer-icon--button">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    </button>
    <a href="https://www.instagram.com/madhudharmadhikari/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
      </svg>
    </a>
  </div>
</footer>

<ContactPopup />

<style>
  .site-footer {
    margin-top: 100px;
    padding: 30px var(--page-margin);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }

  .copyright {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-turkey-red);
  }

  .footer-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .footer-icon {
    color: var(--color-turkey-red);
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .footer-icon:hover {
    opacity: 0.7;
  }

  .footer-icon--button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
</style>
