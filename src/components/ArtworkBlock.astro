---
interface Props {
  number: string;
  title: string;
  image: string;
  href: string;
  imageFit?: 'cover' | 'contain';
}

const { number, title, image, href, imageFit = 'cover' } = Astro.props;
---

<a href={href} class="artwork-block">
  <div class="artwork-inner">
    <span class="artwork-line"></span>
    <div class="artwork-content">
      <span class="artwork-number">{number}</span>
      <div class="artwork-image-wrapper">
        <img src={image} alt={title} loading="lazy" style={`object-fit: ${imageFit};`} />
      </div>
      <span class="artwork-title">{title}</span>
    </div>
  </div>
</a>

<style>
  .artwork-block {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .artwork-inner {
    display: flex;
    align-items: flex-start;
    position: relative;
  }

  /*
    Optical centres, derived from the real font metrics rather than the line boxes.
    Top 16px: La Belle Aurore at 50px/line-height 1 puts the baseline 32.5px down,
    and the digit ink reaches ~16.2px above it, so the glyph centre is 16.4px.
    Bottom 12px: Source Serif 4 at 20px/line-height 1.2 puts the baseline 5px up
    from the box bottom, with the cap-height centre 6.7px above that.
  */
  .artwork-line {
    position: absolute;
    left: 0;
    top: 16px;
    bottom: 12px;
    width: 2px;
    background-color: var(--color-line);
  }

  .artwork-content {
    margin-left: 21px;
    display: flex;
    flex-direction: column;
  }

  .artwork-number {
    font-family: var(--font-display);
    font-size: 50px;
    font-weight: 400;
    color: var(--color-grey);
    line-height: 1;
    margin-bottom: 19px;
  }

  .artwork-image-wrapper {
    width: 165px;
    height: 249px;
    overflow: hidden;
  }

  .artwork-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 0.4s ease;
  }

  .artwork-block:hover .artwork-image-wrapper img {
    transform: scale(1.05);
  }

  .artwork-title {
    margin-top: 20px;
    line-height: 1.2;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 500;
    font-style: italic;
    color: var(--color-eerie-black);
  }
</style>
