---
interface Props {
  number: string;
  title: string;
  image: string;
  href: string;
}

const { number, title, image, href } = Astro.props;
---

<a href={href} class="artwork-block">
  <div class="artwork-inner">
    <span class="artwork-line"></span>
    <div class="artwork-content">
      <span class="artwork-number">{number}</span>
      <div class="artwork-image-wrapper">
        <img src={image} alt={title} loading="lazy" />
      </div>
      <span class="artwork-title">{title}</span>
    </div>
  </div>
</a>

<style>
  .artwork-block {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .artwork-inner {
    display: flex;
    align-items: flex-start;
    position: relative;
  }

  .artwork-line {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 310px;
    background-color: var(--color-line);
  }

  .artwork-content {
    margin-left: 21px;
    display: flex;
    flex-direction: column;
  }

  .artwork-number {
    font-family: var(--font-display);
    font-size: 50px;
    font-weight: 400;
    color: var(--color-grey);
    line-height: 1;
    margin-bottom: 19px;
  }

  .artwork-image-wrapper {
    width: 165px;
    height: 249px;
    overflow: hidden;
  }

  .artwork-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .artwork-block:hover .artwork-image-wrapper img {
    transform: scale(1.05);
  }

  .artwork-title {
    margin-top: 20px;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 500;
    font-style: italic;
    color: var(--color-eerie-black);
  }
</style>
