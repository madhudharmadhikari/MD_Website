---
import '../styles/global.css';
import { base } from '../lib/paths';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <title>Madhura Dharmadhikari</title>
  </head>
  <body>
    <div class="landing">
      <div class="landing-bg">
        <img
          src={`${base}images/landing.jpg`}
          alt=""
          class="landing-poster"
        />
        <!--
          Replace the img above with a video element when ready:
          <video autoplay muted loop playsinline>
            <source src={`${base}videos/landing.mp4`} type="video/mp4" />
          </video>
        -->
      </div>
      <a href={`${base}artworks`} class="landing-title">Madhura Dharmadhikari</a>
    </div>

    <script is:inline>
      document.addEventListener('contextmenu', function (e) {
        if (e.target.tagName === 'IMG' || e.target.tagName === 'VIDEO') {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=La+Belle+Aurore&display=swap');

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
</style>

<style>
  .landing {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Fallback shown only while the image loads; sampled from its darkest tone. */
    background-color: #0a0a0a;
  }

  .landing-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .landing-bg img,
  .landing-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .landing-title {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    font-family: 'La Belle Aurore', cursive;
    font-size: 50px;
    font-weight: 400;
    color: #ffffff;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
    text-decoration: none;
    transition: opacity 0.3s ease;
    user-select: none;
  }

  .landing-title:hover {
    opacity: 0.8;
  }
</style>
