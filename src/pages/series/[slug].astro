---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TextBox from '../../components/TextBox.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import ContinueReading from '../../components/ContinueReading.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getAllArtworks, getArtworkById, getRelatedArtworks } from '../../data/artworks';

export function getStaticPaths() {
  const allArtworks = getAllArtworks();
  return allArtworks.map((artwork) => ({
    params: { slug: artwork.id },
  }));
}

import { base } from '../../lib/paths';
const prefixPath = (p: string) => `${base}${p.replace(/^\//, '')}`;

const { slug } = Astro.params;
const artwork = getArtworkById(slug!)!;
const related = getRelatedArtworks(slug!, 2);

const galleryImages = artwork.galleryImages.map(prefixPath);

// Series whose images should never be cropped (object-fit: contain instead of cover).
const uncroppedSeries = new Set(['nostalgia', 'dolce-far-niente', 'flaw-ruh', 'noon', 'a-perfect-intersection', 'pressed-flowers']);
const imgFit = uncroppedSeries.has(artwork.id) ? 'contain' : 'cover';
const imgPosition = artwork.id === 'first-reflections' ? 'center bottom' : 'center';

const continueReadingPositions: Record<string, string> = {
  'the-white-frame': 'top',
  nostalgia: 'bottom',
};

const continueItems = related.map((r) => ({
  title: r.title,
  image: prefixPath(r.image),
  href: `${base}series/${r.id}`,
  objectPosition: continueReadingPositions[r.id],
}));
---

<BaseLayout title={`${artwork.title} — Madhura Dharmadhikari`} currentPage={artwork.category}>
  {artwork.layout === 'carousel' && (
    <section class="series-carousel">
      <div class="series-carousel-wrapper">
        <ImageCarousel
          images={galleryImages}
          width={960}
          height={711}
          fit={imgFit}
          lightbox={false}
        />
      </div>
      <div class="series-carousel-text">
        <TextBox title={artwork.title} date={artwork.date} body={artwork.description} />
      </div>
    </section>
  )}

  {artwork.layout === 'equigrid' && (
    <section class="series-equigrid">
      <div class="series-equigrid-text">
        <TextBox title={artwork.title} date={artwork.date} body={artwork.description} />
      </div>
      <div class="series-equigrid-grid">
        {galleryImages.map((src, i) => (
          <div class="equigrid-image" data-lightbox-trigger data-lightbox-index={i} role="button" tabindex="0">
            <img src={src} alt="" loading="lazy" style={`object-fit: ${imgFit};`} />
          </div>
        ))}
      </div>
    </section>
  )}

  {artwork.layout === 'alternate' && (
    <section class="series-alternate">
      <div class="series-alternate-text">
        <TextBox
          title={artwork.title}
          date={artwork.date}
          body={artwork.description}
          bodyWidth={710}
          offsetX={365}
        />
      </div>
      <div class="series-alternate-grid">
        {galleryImages.map((src, i) => {
          const groupIndex = Math.floor(i / 3);
          const isLoneTrailingImage = artwork.id === 'pressed-flowers' && i === galleryImages.length - 1;
          const posInGroup = isLoneTrailingImage ? 2 : i % 3;

          if (posInGroup < 2) {
            return (
              <div
                class:list={['alternate-image', posInGroup === 0 ? 'alternate-image--left' : 'alternate-image--right']}
                data-lightbox-trigger
                data-lightbox-index={i}
                role="button"
                tabindex="0"
              >
                <img src={src} alt="" loading="lazy" style={`object-fit: ${imgFit}; object-position: ${imgPosition};`} />
              </div>
            );
          }
          return (
            <div
              class:list={['alternate-image', 'alternate-image--center', { 'alternate-image--trailing': isLoneTrailingImage }]}
              data-lightbox-trigger
              data-lightbox-index={i}
              role="button"
              tabindex="0"
            >
              <img src={src} alt="" loading="lazy" style={`object-fit: ${imgFit}; object-position: ${imgPosition};`} />
            </div>
          );
        })}
      </div>
    </section>
  )}

  {artwork.layout === 'wheel' && (
    <section class="series-wheel">
      <div class="series-wheel-inner">
        <div class="series-wheel-text">
          <TextBox
            title={artwork.title}
            date={artwork.date}
            body={artwork.description}
            bodyWidth={485}
          />
        </div>
        <div class="series-wheel-images">
          {galleryImages.map((src, i) => (
            <div class="wheel-image" data-lightbox-trigger data-lightbox-index={i} role="button" tabindex="0">
              <img src={src} alt="" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContinueReading items={continueItems} />
  <Lightbox images={galleryImages} />
</BaseLayout>

<style>
  /* ===================== CAROUSEL LAYOUT ===================== */
  .series-carousel {
    margin-top: 100px;
  }

  .series-carousel-wrapper {
    padding: 0 var(--page-margin);
  }

  .series-carousel-text {
    margin-top: 100px;
  }

  /* ===================== EQUIGRID LAYOUT ===================== */
  .series-equigrid {
    margin-top: 100px;
  }

  .series-equigrid-text {
    margin-bottom: 100px;
  }

  .series-equigrid-grid {
    padding: 0 var(--page-margin);
    display: grid;
    grid-template-columns: 530px 530px;
    gap: 25px;
    justify-content: center;
  }

  .equigrid-image {
    width: 530px;
    aspect-ratio: 530 / 647;
    overflow: hidden;
  }

  .equigrid-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===================== ALTERNATE LAYOUT ===================== */
  .series-alternate {
    margin-top: 100px;
  }

  .series-alternate-text {
    margin-bottom: 100px;
  }

  .series-alternate-grid {
    padding: 0 var(--page-margin);
    display: flex;
    flex-wrap: wrap;
    gap: 150px 50px;
    align-items: center;
  }

  .alternate-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .alternate-image--left {
    width: 518px;
    aspect-ratio: 518 / 633;
    overflow: hidden;
  }

  .alternate-image--right {
    width: 518px;
    aspect-ratio: 518 / 518;
    overflow: hidden;
    align-self: center;
  }

  .alternate-image--center {
    width: 652px;
    aspect-ratio: 652 / 753;
    overflow: hidden;
    margin: 0 auto;
  }

  .alternate-image--trailing {
    margin-top: -100px;
  }

  /* ===================== WHEEL LAYOUT ===================== */
  .series-wheel {
    margin-top: 100px;
  }

  .series-wheel-inner {
    padding: 0 var(--page-margin);
    display: flex;
    gap: 50px;
    align-items: flex-start;
  }

  .series-wheel-text {
    flex: 0 0 485px;
    position: sticky;
    top: 100px;
    align-self: flex-start;
  }

  .series-wheel-text :global(.text-box) {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .series-wheel-images {
    flex: 0 0 586px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    overflow: hidden;
  }

  .wheel-image {
    width: 586px;
    overflow: hidden;
  }

  .wheel-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* ===================== LIGHTBOX TRIGGERS ===================== */
  [data-lightbox-trigger] {
    cursor: pointer;
  }

  /* ===================== MOBILE ===================== */
  @media (max-width: 900px) {
    .series-equigrid-grid {
      grid-template-columns: 1fr;
      max-width: 530px;
      margin: 0 auto;
      gap: 40px;
    }

    .equigrid-image {
      width: 100%;
    }

    .series-alternate-grid {
      gap: 40px;
    }

    .alternate-image--left,
    .alternate-image--right,
    .alternate-image--center {
      width: 100%;
      max-width: 518px;
      margin: 0 auto;
      align-self: center;
    }

    .alternate-image--center {
      max-width: 652px;
    }

    .alternate-image--trailing {
      margin-top: 0;
    }

    .series-wheel-inner {
      flex-direction: column;
    }

    .series-wheel-text {
      position: static;
      flex-basis: auto;
      width: 100%;
    }

    .series-wheel-images {
      flex-basis: auto;
      width: 100%;
    }

    .wheel-image {
      width: 100%;
    }
  }
</style>
