---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../lib/paths';
---

<BaseLayout title="About — Madhura Dharmadhikari" currentPage="about">
  <section class="about-content">
    <div class="about-column">
      <div class="about-image-block">
        <div class="about-line"></div>
        <div class="about-image-wrapper">
          <img
            src={`${base}images/about.jpg`}
            alt="Madhura Dharmadhikari"
            class="about-image"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-content {
    position: relative;
    padding: 0 var(--page-margin);
    margin-top: 100px;
  }

  @media (max-width: 900px) {
    /* Right side stays a plain 40px; left side adds the line's 10px
       poke so both edges read as the same visual margin. */
    .about-content {
      padding-left: 50px;
      padding-right: 40px;
    }
  }

  @media (max-width: 480px) {
    .about-content {
      padding-left: 42px;
      padding-right: 32px;
    }
  }

  .about-column {
    position: relative;
    display: flow-root;
    width: 687px;
    max-width: 100%;
    margin: 0 auto;
  }

  .about-image-block {
    position: relative;
    display: flow-root;
  }

  .about-line {
    position: absolute;
    left: -21px;
    top: 0;
    bottom: -45px;
    width: 2px;
    background-color: var(--color-line);
    border-radius: 1px;
  }

  .about-image-wrapper {
    width: 100%;
    aspect-ratio: 687 / 1037;
    margin-top: 21px;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    /* Same poke as desktop, scaled down for the smaller image: the line
       still runs a little past the image's top/bottom/left edges, it's
       just proportionally smaller. */
    .about-image-wrapper {
      margin-top: 10px;
    }

    .about-line {
      left: -10px;
      top: 0;
      bottom: -22px;
    }
  }

  .about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .about-text {
    margin-top: 30px;
    width: 100%;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    color: var(--color-eerie-black);
    line-height: 1.6;
  }

  .about-text p {
    margin-bottom: 20px;
  }

  @media (max-width: 900px) {
    .about-text {
      font-size: 18px;
    }
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }
</style>
