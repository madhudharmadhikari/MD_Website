---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkBlock from '../components/ArtworkBlock.astro';
import { archives } from '../data/artworks';

import { base } from '../lib/paths';

// 2-column alternating: col1, col2
const col1Items = archives.filter((_, i) => i % 2 === 0);
const col2Items = archives.filter((_, i) => i % 2 === 1);
---

<BaseLayout title="Archives — Madhura Dharmadhikari" currentPage="archives">
  <section class="archives-grid archives-grid--desktop">
    <div class="archives-col archives-col--1">
      {col1Items.map((item) => (
        <div class="archives-item">
          <ArtworkBlock
            number={item.number}
            title={item.title}
            image={`${base}${item.image.replace(/^\//, '')}`}
            href={`${base}series/${item.id}`}
            imageFit={item.imageFit}
          />
        </div>
      ))}
    </div>
    <div class="archives-col archives-col--2">
      {col2Items.map((item) => (
        <div class="archives-item">
          <ArtworkBlock
            number={item.number}
            title={item.title}
            image={`${base}${item.image.replace(/^\//, '')}`}
            href={`${base}series/${item.id}`}
            imageFit={item.imageFit}
          />
        </div>
      ))}
    </div>
  </section>

  <section class="archives-grid archives-grid--mobile">
    {archives.map((item) => (
      <div class="archives-item">
        <ArtworkBlock
          number={item.number}
          title={item.title}
          image={`${base}${item.image.replace(/^\//, '')}`}
          href={`${base}series/${item.id}`}
          imageFit={item.imageFit}
        />
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .archives-grid--desktop {
    display: flex;
    gap: 264px;
    padding: 0 var(--page-margin);
    margin-top: 100px;
    justify-content: center;
  }

  .archives-col {
    display: flex;
    flex-direction: column;
    gap: 182px;
  }

  .archives-col--1 {
    padding-top: 0;
  }

  .archives-col--2 {
    padding-top: 259px;
  }

  .archives-grid--mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .archives-grid--desktop {
      display: none;
    }

    .archives-grid--mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 56px;
      padding: 0 var(--page-margin);
      margin-top: 100px;
    }
  }
</style>
