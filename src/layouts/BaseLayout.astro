---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  currentPage?: 'artworks' | 'archives' | 'about';
  showHeader?: boolean;
  showFooter?: boolean;
  headerVariant?: 'default' | 'about';
}

const {
  title = 'Madhura Dharmadhikari',
  currentPage,
  showHeader = true,
  showFooter = true,
  headerVariant = 'default',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Madhura Dharmadhikari — Visual Contemporary Artist" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-wrapper">
      {showHeader && <Header currentPage={currentPage} variant={headerVariant} />}
      <main>
        <slot />
      </main>
      {showFooter && <Footer />}
    </div>

    <script is:inline>
      document.addEventListener('contextmenu', function (e) {
        if (e.target.tagName === 'IMG') {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>

<style>
  .page-wrapper {
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
  }
</style>
